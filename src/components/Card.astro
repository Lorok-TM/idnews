---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;

// Amankan data ogImage soko TypeScript error
const ogImage = (data as any).ogImage as string | undefined;

// =========================================================================
// 🔥 SULAP UTAMANE URL & TARGET GENERATED IMAGE (IMG SRC)
// =========================================================================
const postUrl = getPostUrl(id, filePath, Astro.currentLocale).replace(/^\/posts/, "");

// KUNCINE: Sanajan URL post wis dadi root domain, manggake rute generator index.png-ne
// TETEP awake dhewe arahno mlebu menyang folder /posts/ bawaan endpoint asline Vercel!
const fallbackImage = `/posts${postUrl.replace(/\/$/, "")}/index.png`; 

const finalImage = ogImage || fallbackImage;
---

<li class="my-6">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
<div class="bg-img" data-bg={finalImage}/>
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <Datetime {...props} />
  <p>{description}</p>
</li>
