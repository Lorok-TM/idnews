---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
);

// Jupuk path URL saiki kanggo deteksi halaman
const pathname = Astro.url.pathname;

// Inisialisasi variabel anyar khusus kanggo Meta Tag HTML
let metaTitle = title;
let metaDesc = description;

// LOGIKA PENGKONDISIAN (IF - ELSE) DIENGGO ING KENE
if (pathname === '/' || pathname === '/index.html') {
  // HOME / UTAMA
  metaTitle = `${title} - Berita Seputar Investasi, Bisnis, Teknologi`;
  metaDesc = `${description}`;

} else if (pathname.startsWith('/tags/')) {
  // HALAMAN TAGS
  metaTitle = `Arsip ${title}`;
  metaDesc = `${description}`;

} else if (pathname.startsWith('/posts/') || pathname.startsWith('/blog/')) {
  // HALAMAN POST / ARTIKEL SINGLE
  metaTitle = `${title}`;
  metaDesc = `${description}`;

} else if (pathname.startsWith('/page/') || pathname.includes('/p/')) {
  // HALAMAN PAGE (About, Contact, dll)
  metaTitle = `Halaman ${title}`;
  metaDesc = `${description}`;

} else if (pathname.startsWith('/archives/') || pathname.startsWith('/arsip/')) {
  // HALAMAN ARCHIVE
  metaTitle = `Halaman ${title}`;
  metaDesc = `${description}`;

} else {
  // DEFAULT / SAK KAREPMU (Yen ora mlebu kondisi ndhuwur)
  metaTitle = `Halaman ${title}`;
  metaDesc = `${description}`;
}
---

<!doctype html>
<html dir={site.dir ?? "ltr"} lang={Astro.currentLocale ?? site.lang} class="overflow-y-scroll scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://id-news.vercel.app/favicon.ico" rel="icon" type="image/x-icon" />
    <link href="https://id-news.vercel.app/favicon.svg" rel="icon" type="image/svg+xml" />

    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-google-sans-code" preload={[{ subset: "latin", weight: 400, style: "normal" }]} />

    <title>{metaTitle}</title>
    <meta name="title" content={metaTitle} />
    <meta name="description" content={metaDesc} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDesc} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:site" content="@id-news" />

    <link rel="alternate" type="application/rss+xml" title={site.title} href={new URL(rssHref, Astro.site)} />

    <meta content='#fff' name='theme-color' />
    <meta content='#fff' name='msapplication-navbutton-color' />
    <meta content='#fff' name='apple-mobile-web-app-status-bar-style' />
    <meta content='yes' name='mobile-web-app-capable' />
    <link rel="manifest" href="/manifest.json" />

    <meta name="google-site-verification" content="gZct-lzgHHdKpx5r-KpUVkdsKD7UEyqbWy4sCQmIntI" />
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
<script is:inline>if ('serviceWorker' in navigator) { window.addEventListener('load', function() { navigator.serviceWorker.register('/sw.js') .then(function(registration) { console.log('PWA ServiceWorker sukses didaftarkan di scope: ', registration.scope); }) .catch(function(err) { console.log('PWA ServiceWorker gagal didaftarkan: ', err); }); }); }</script>
<style is:inline>
.bg-img{background-color:rgb(155 155 155/.1);background-size:cover;background-position:center;background-repeat:no-repeat}
.mt-posts .bg-img{width:100%;aspect-ratio:16/9;margin-bottom:5px;border-radius:8px}
.mt-posts a{position:relative;display:block}
.mt-posts h2,.mt-posts h3{line-height:1.3;margin-bottom:6px}
.mt-posts time{margin-bottom:5px}
@media (width > 480px) {.mt-posts{position:relative;display:grid;grid-gap:15px;grid-template-columns:1fr 1fr}.mt-posts li{margin-bottom:0}}
@media (width > 768px) {.mt-posts{grid-gap:20px}}

.app-prose table tr:nth-child(2n) {background-color:rgb(240 249 255/.1)}
.app-prose table th,.app-prose table td{padding:6px 13px}
.app-prose table th{font-weight:bold;background-color:rgb(155 155 155/.1)}
footer.app-layout{margin-top:20px}

.related-post{position:relative;margin:24px 0}
.related-post .related-title{font-size:18px;font-weight:bold}

#cookieChoiceInfo{display:none}
#pwa-combo-container{display:flex;position:fixed;z-index:99999;bottom:0;right:0;background-color:rgb(245, 247, 250);color:#292c3a;padding:5px;border-top-left-radius:10px;align-items:center;gap:8px}#pwa-combo-container button{background:transparent;color:#292c3a;cursor:pointer;display:flex;align-items:center;justify-content:center;border:none}.pwa-btn{gap:6px;padding:6px 12px;font-family:system-ui,-apple-system,sans-serif;font-weight:600;font-size:15px}.pwa-notif-btn,.pwa-close-btn{width:36px;height:36px;font-size:18px}

</style>
  </head>
  <body class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col">
    <slot />
    <script>
      import "@/scripts/theme";
    </script>

<script is:inline>
let timerJsb;const jsb = () => {["mousemove", "mousedown", "touchstart", "scroll", "pointermove", "keydown", "click"].forEach(e => {window.removeEventListener(e, jsb);});clearTimeout(timerJsb);
(function() {const aGb = (el) => {const imgUrl = el.getAttribute('data-bg');if (imgUrl) {el.style.backgroundImage = `url('${imgUrl}')`;el.removeAttribute('data-bg');}};const loadAwal = () => {document.querySelectorAll('[data-bg]').forEach(aGb);};if (document.readyState === 'loading') {document.addEventListener('DOMContentLoaded', loadAwal);} else {loadAwal();} const observer = new MutationObserver((mutations) => {mutations.forEach(mutation => {mutation.addedNodes.forEach(node => {if (node.nodeType === 1) {const bgs = node.querySelectorAll ? node.querySelectorAll('[data-bg]') : [];bgs.forEach(aGb);if (node.hasAttribute('data-bg')) aGb(node);}});});});observer.observe(document.body, { childList: true, subtree: true });})();
var adsb=document.createElement("script");adsb.src="https://bauval.org/14/a88e4d9b2bd314b7de340c1c49dc6a16";document.body.appendChild(adsb);
console.log("Script jsb Aktif!");};const initJsb = () => {clearTimeout(timerJsb); ["mousemove", "mousedown", "touchstart", "scroll", "pointermove", "keydown", "click"].forEach(e => {window.addEventListener(e, jsb, { passive: true });});timerJsb = setTimeout(jsb, 4000);};initJsb();document.addEventListener('astro:page-load', () => {console.log("init ulang jsb");initJsb();});
</script>

<div id="pwa-combo-container" style="display: none;">
<button id="pwa-install-btn" class="pwa-btn" style="display: none;"><span class="pwa-icon">📲</span><span class="pwa-text">Install ID News</span></button><button id="pwa-notif-btn" class="pwa-notif-btn" style="display: none;" title="Aktifkan Notifikasi">🔔</button><button id="pwa-close-btn" class="pwa-close-btn" aria-label="Close">&times;</button>
</div>
<script is:inline>
  let deferredPrompt;
  const comboContainer = document.getElementById('pwa-combo-container');
  const installBtn = document.getElementById('pwa-install-btn');
  const notifBtn = document.getElementById('pwa-notif-btn');
  const closeBtn = document.getElementById('pwa-close-btn');
  let PwaSiapInstal = false;
  let NotifSiapMinta = false;
  if ("Notification" in window) {
    if (Notification.permission === "default") {
      NotifSiapMinta = true;
    }
  }
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    PwaSiapInstal = true;
    console.log("Situs siap diinstal.");
    evaluasiTampilanWadah();
  });
  document.addEventListener("DOMContentLoaded", () => {
    evaluasiTampilanWadah();
  });
  function evaluasiTampilanWadah() {
    const isDismissed = sessionStorage.getItem('pwa-combo-dismissed');
    if (isDismissed) return;
    let kuduNongol = false;
    if (PwaSiapInstal && installBtn) {
      installBtn.style.display = 'flex';
      kuduNongol = true;
    } else if (installBtn) {
      installBtn.style.display = 'none';
    }
    if (NotifSiapMinta && notifBtn) {
      notifBtn.style.display = 'flex';
      kuduNongol = true;
    } else if (notifBtn) {
      notifBtn.style.display = 'none';
    }
    if (kuduNongol && comboContainer) {
      comboContainer.style.display = 'flex';
    } else if (comboContainer) {
      comboContainer.style.display = 'none';
    }
  }
  if (installBtn) {
    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      console.log(`Pilihan instalasi: ${outcome}`);
      deferredPrompt = null;
      PwaSiapInstal = false;
      evaluasiTampilanWadah();
    });
  }
  if (notifBtn) {
    notifBtn.addEventListener('click', () => {
      if (!("Notification" in window)) return;
      Notification.requestPermission().then(permission => {
        if (permission === "granted") {
          alert("Terima Kasih, notifikasi sudah aktif, bro!");
          navigator.serviceWorker.ready.then(reg => {
            console.log("Service Worker siap untuk push:", reg);
          });
        } else if (permission === "denied") {
          alert("Ijin ditolak. Jika ingin mengaktifkan, harus lewat setelan gembok browser, bro.");
        }
        NotifSiapMinta = false;
        evaluasiTampilanWadah();
      });
    });
  }
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      if (comboContainer) {
        comboContainer.style.display = 'none';
        sessionStorage.setItem('pwa-combo-dismissed', 'true');
        console.log('User menutup menu akselerasi PWA pada sesi ini.');
      }
    });
  }
  window.addEventListener('appinstalled', () => {
    PwaSiapInstal = false;
    evaluasiTampilanWadah();
  });
</script>
  </body>
</html>
